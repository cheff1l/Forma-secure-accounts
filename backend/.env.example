# Copy this file to backend/.env. Never upload that file or share passwords in chat.
BASE_URL=http://127.0.0.1:5173
COOKIE_SECURE=0
CAPTCHA_PROVIDER=hcaptcha

# Gmail: enable 2-Step Verification on the sending account, then create an app password.
# Use the Gmail address as both SMTP_USER and SMTP_FROM.
DEMO_MODE=0
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Cloudflare Turnstile: create a widget for 127.0.0.1 (local development).
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# hCaptcha widget for registration and password reset.
# hCaptcha does not accept localhost or 127.0.0.1 as website hostnames.
HCAPTCHA_SITE_KEY=
HCAPTCHA_SECRET_KEY=
HCAPTCHA_ORIGIN=http://forma.localtest.me:5173

# Google Cloud OAuth client type: Web application.
# Authorized redirect URI: http://127.0.0.1:5173/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
